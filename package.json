{
  "name": "ai-web-scraper",
  "version": "1.0.0",
  "description": "基于 Firecrawl 的智能网页信息抓取工具",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "firecrawl",
    "web-scraping",
    "ai",
    "information-extraction",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^4.3.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.6"
  }
}
